rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Existing rules for places and chats collections
    match /places/{document} {
      allow read, write: if request.auth != null;
    }
    
    match /chats/{document} {
      allow read, write: if request.auth != null;
    }
    
    // Allow authenticated users to read/write to the Tourism subcollections
    match /Tourism/{document}/Places/{placeId} {
      allow read, write: if request.auth != null;
    }

    // Allow permissions for districts collection and its subcollections
    match /districts/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default fallback rule (deny everything else)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
